<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.causalmesh.mcp</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/mesh-mcp</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- OS Politeness: Background priority & low IO per RFC-001 Section 5.6 -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardErrorPath</key>
    <string>/tmp/mesh-mcp.stderr.log</string>
</dict>
</plist>
